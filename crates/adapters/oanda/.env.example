# OANDA API Credentials
# Copy this file to .env and fill in your credentials
#
# Get your API token from: https://www.oanda.com/demo-account/tpa/personal_token
# Practice account: https://fxpractice.oanda.com
# Live account: https://fxtrade.oanda.com

# Generic credentials (used if environment-specific not found)
OANDA_API_KEY=your-api-token-here
OANDA_ACCOUNT_ID=your-account-id-here

# Environment-specific credentials (optional)
# OANDA_PRACTICE_API_KEY=your-practice-api-token
# OANDA_PRACTICE_ACCOUNT_ID=your-practice-account-id
# OANDA_LIVE_API_KEY=your-live-api-token
# OANDA_LIVE_ACCOUNT_ID=your-live-account-id
